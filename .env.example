# Finance Tracker — Environment Variables
# Copy this file to backend/.env and fill in your values.
# Only non-default values need to be set.

# ── App ──────────────────────────────────────────────────
# APP_NAME=Finance Tracker v2
# DEBUG=False
# HOST=0.0.0.0
# PORT=8080

# ── Database ─────────────────────────────────────────────
# DATABASE_URL=sqlite:///./data/financial-tracker.db

# ── Auth (REQUIRED — change for production) ──────────────
JWT_SECRET=CHANGE-ME-generate-a-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=1440

# ── File Upload ──────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=10
# DATA_DIR=./data

# ── CORS Origins ─────────────────────────────────────────
# Comma-separated list of allowed origins for frontend access.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM Parsing (optional) ──────────────────────────────
# LLM_PROVIDER=none  # "gemini" | "ollama" | "none"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# ── Google Drive Sync (optional) ─────────────────────────
# GDRIVE_ENABLED=False
# GDRIVE_CREDENTIALS_FILE=
# GDRIVE_FOLDER_ID=
# GDRIVE_POLL_INTERVAL_MINUTES=60
