# Finance Tracker — Environment Variables
# Copy this file to backend/.env and fill in your values.
# Only non-default values need to be set.

# ── App ──────────────────────────────────────────────────
# APP_NAME=Finance Tracker v2
# DEBUG=False
# HOST=0.0.0.0
# PORT=8080

# ── Database ─────────────────────────────────────────────
# DATABASE_URL=sqlite:///./data/finance_tracker.db

# ── Auth (REQUIRED — change for production) ──────────────
JWT_SECRET=CHANGE-ME-generate-a-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=1440

# ── File Upload ──────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=10
# DATA_DIR=./data

# ── CORS Origins ─────────────────────────────────────────
# Comma-separated list of allowed origins for frontend access.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM Parsing (optional) ──────────────────────────────
# LLM_PROVIDER=ollama  # "gemini" | "ollama" | "none"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_MODEL=lfm2-extract
# OLLAMA_HOST=http://localhost:11434

# ── Google Drive Sync (OAuth2) ───────────────────────────
# Place your credentials_google.json (Google OAuth Desktop App client secrets)
# in the backend directory. No additional env vars needed for basic setup.
# GDRIVE_OAUTH_SECRETS_FILE=credentials_google.json

# ── Local Directory Sync (optional) ──────────────────────
# LOCAL_SYNC_PATH=              # Local folder path containing statement files
# LOCAL_SYNC_MAX_FILES=500      # Max files to return per scan
# LOCAL_SYNC_ALLOWED_ROOTS=     # Comma-separated allowed root dirs (empty = home + data_dir)
